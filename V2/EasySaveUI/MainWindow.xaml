<Window x:Class="EasySaveUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EasySave" Height="500" Width="850">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="EasySave" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button x:Name="BtnSettings" Content="⚙ Settings" Margin="20,0,0,0"
                    Click="BtnSettings_Click" Padding="8,4"/>
        </StackPanel>

        <!-- Backup Jobs List -->
        <DataGrid Grid.Row="1" x:Name="JobsGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Source" Binding="{Binding SourcePath}" Width="200"/>
                <DataGridTextColumn Header="Target" Binding="{Binding TargetPath}" Width="200"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="BtnAdd" Content="+ Add" Margin="5"
                    Click="BtnAdd_Click" Padding="10,5"/>
            <Button x:Name="BtnRemove" Content="✖ Remove" Margin="5"
                    Click="BtnRemove_Click" Padding="10,5"/>
            <Button x:Name="BtnRun" Content="▶ Run" Margin="5"
                    Click="BtnRun_Click" Padding="10,5"/>
            <Button x:Name="BtnRunAll" Content="▶▶ Run All" Margin="5"
                    Click="BtnRunAll_Click" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>