<Window x:Class="EasySaveUI.AddJobWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Backup Job" Height="300" Width="450"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Name -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TxtName" Margin="0,5"/>

        <!-- Source -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Source:" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtSource" Margin="0,5"/>
        <Button Grid.Row="1" Grid.Column="2" Content="..." Margin="5,5,0,5"
                Click="BtnBrowseSource_Click" Padding="5,0"/>

        <!-- Target -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Target:" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtTarget" Margin="0,5"/>
        <Button Grid.Row="2" Grid.Column="2" Content="..." Margin="5,5,0,5"
                Click="BtnBrowseTarget_Click" Padding="5,0"/>

        <!-- Type -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Type:" VerticalAlignment="Center" Margin="0,5"/>
        <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="CmbType" Margin="0,5">
            <ComboBoxItem Content="Complete" IsSelected="True"/>
            <ComboBoxItem Content="Differential"/>
        </ComboBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Add" Margin="5,0,0,0" Padding="15,5"
                    Click="BtnAdd_Click"/>
            <Button Content="Cancel" Margin="5,0,0,0" Padding="15,5"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>