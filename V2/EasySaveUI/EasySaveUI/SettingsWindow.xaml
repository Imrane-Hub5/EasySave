<Window x:Class="EasySaveUI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="350" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Text="⚙ Settings" FontSize="18" FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Log Format -->
        <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="Log Format :" VerticalAlignment="Center" Margin="0,0,0,12"/>
        <ComboBox Grid.Row="1" Grid.Column="1"
                  SelectedItem="{Binding LogFormat}"
                  Margin="0,0,0,12">
            <ComboBoxItem>JSON</ComboBoxItem>
            <ComboBoxItem>XML</ComboBoxItem>
        </ComboBox>

        <!-- Business Software -->
        <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="Business Software :" VerticalAlignment="Center" Margin="0,0,0,12"/>
        <TextBox Grid.Row="2" Grid.Column="1"
                 Text="{Binding BusinessSoftware, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,12" Padding="4"/>

        <!-- Encrypted Extensions -->
        <TextBlock Grid.Row="3" Grid.Column="0"
                   Text="Encrypted Extensions :" VerticalAlignment="Top" Margin="0,4,0,12"/>
        <TextBox Grid.Row="3" Grid.Column="1"
                 Text="{Binding EncryptedExtensions, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,12" Padding="4"/>

        <!-- Help text -->
        <TextBlock Grid.Row="4" Grid.ColumnSpan="2"
                   Text="Extensions: separate with commas (e.g. .txt, .docx, .pdf)"
                   FontStyle="Italic" Foreground="Gray" FontSize="11"
                   Margin="0,0,0,8"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="0,0,10,0"
                    Click="BtnCancel_Click" Padding="6,4"/>
            <Button Content="Save" Width="80"
                    Command="{Binding SaveCommand}"
                    Click="BtnSave_Click" Padding="6,4"/>
        </StackPanel>
    </Grid>
</Window>
