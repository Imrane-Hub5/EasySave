<Window x:Class="EasySaveUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasySave" Height="580" Width="1000"
        MinHeight="480" MinWidth="800"
        WindowStartupLocation="CenterScreen">

    <Window.Icon>
        <DrawingImage>
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#1976D2"
                        Geometry="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z"/>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Icon>

    <Grid Background="{DynamicResource PageBGBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- ══ HEADER ══════════════════════════════════════════════ -->
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1976D2" Offset="0"/>
                    <GradientStop Color="#1E88E5" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="24,0">
                <!-- Left: brand -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="26" Height="26" Margin="0,0,10,0">
                        <Canvas Width="24" Height="24">
                            <Path Fill="White"
                                  Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="EasySave" FontSize="20" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <Border Background="#1565C0" CornerRadius="4" Padding="7,2"
                            Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v3" FontSize="11" FontWeight="SemiBold" Foreground="#90CAF9"/>
                    </Border>
                </StackPanel>

                <!-- Right: dark mode + settings -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnTheme" Content="🌙  Dark"
                            Style="{StaticResource GhostBtn}"
                            Margin="0,0,8,0"
                            Click="BtnTheme_Click"/>
                    <Button x:Name="BtnSettings" Content="⚙  Settings"
                            Style="{StaticResource GhostBtn}"
                            Click="BtnSettings_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ CONTENT ═════════════════════════════════════════════ -->
        <Border Grid.Row="1" Margin="20,16,20,0"
                Background="{DynamicResource SurfaceBrush}" CornerRadius="10"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.06" Direction="270"/>
            </Border.Effect>

            <DataGrid x:Name="JobsGrid" SelectionMode="Single">
                <DataGrid.Columns>

                    <!-- Name -->
                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight"        Value="SemiBold"/>
                                <Setter Property="Foreground"        Value="{DynamicResource TextPrimBrush}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding"           Value="14,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Source -->
                    <DataGridTextColumn Header="SOURCE" Binding="{Binding SourcePath}" Width="175">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"        Value="{DynamicResource TextMutedBrush}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding"           Value="14,0"/>
                                <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip"           Value="{Binding SourcePath}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Target -->
                    <DataGridTextColumn Header="TARGET" Binding="{Binding TargetPath}" Width="175">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"        Value="{DynamicResource TextMutedBrush}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding"           Value="14,0"/>
                                <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip"           Value="{Binding TargetPath}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Type badge -->
                    <DataGridTemplateColumn Header="TYPE" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="TypeBadge" CornerRadius="5" Padding="9,3"
                                        HorizontalAlignment="Left" Margin="14,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="TypeText" Text="{Binding Type}"
                                               FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Type}" Value="Complete">
                                        <Setter TargetName="TypeBadge" Property="Background" Value="#DBEAFE"/>
                                        <Setter TargetName="TypeText"  Property="Foreground" Value="#1D4ED8"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="Differential">
                                        <Setter TargetName="TypeBadge" Property="Background" Value="#FEF3C7"/>
                                        <Setter TargetName="TypeText"  Property="Foreground" Value="#92400E"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Status badge -->
                    <DataGridTemplateColumn Header="STATUS" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,7,0"/>
                                    <TextBlock x:Name="StatusText" Text="{Binding Status}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Active">
                                        <Setter TargetName="StatusDot"  Property="Fill"       Value="#16A34A"/>
                                        <Setter TargetName="StatusText" Property="Foreground"  Value="#15803D"/>
                                        <Setter TargetName="StatusText" Property="FontWeight"  Value="SemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Inactive">
                                        <Setter TargetName="StatusDot"  Property="Fill"       Value="#9CA3AF"/>
                                        <Setter TargetName="StatusText" Property="Foreground"  Value="#9CA3AF"/>
                                        <Setter TargetName="StatusText" Property="FontWeight"  Value="Normal"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Paused">
                                        <Setter TargetName="StatusDot"  Property="Fill"       Value="#D97706"/>
                                        <Setter TargetName="StatusText" Property="Foreground"  Value="#D97706"/>
                                        <Setter TargetName="StatusText" Property="FontWeight"  Value="SemiBold"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Progress bar + % -->
                    <DataGridTemplateColumn Header="PROGRESS" Width="165">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center" Margin="14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="38"/>
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar Grid.Column="0" Height="6"
                                                 Minimum="0" Maximum="100"
                                                 Value="{Binding Progression}"
                                                 Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Progression, StringFormat={}{0:0}%}"
                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Controls: Pause / Play / Stop -->
                    <DataGridTemplateColumn Header="" Width="108">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                    <Button Command="{Binding PauseCommand}"
                                            Style="{StaticResource IconBtn}"
                                            Foreground="#1976D2"
                                            ToolTip="Pause">
                                        <TextBlock Text="⏸" FontSize="14"/>
                                    </Button>
                                    <Button Command="{Binding PlayCommand}"
                                            Style="{StaticResource IconBtn}"
                                            Foreground="#16A34A"
                                            Margin="2,0"
                                            ToolTip="Resume">
                                        <TextBlock Text="▶" FontSize="13"/>
                                    </Button>
                                    <Button Command="{Binding StopCommand}"
                                            Style="{StaticResource IconBtn}"
                                            Foreground="#DC2626"
                                            ToolTip="Stop">
                                        <TextBlock Text="⏹" FontSize="14"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ══ TOOLBAR ══════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource ToolbarBGBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="BtnAdd" Content="＋  Add Job"
                        Style="{StaticResource SecondaryBtn}"
                        Margin="6,0" Click="BtnAdd_Click"/>
                <Button x:Name="BtnRemove" Content="✕  Remove"
                        Style="{StaticResource SecondaryBtn}"
                        Margin="6,0" Click="BtnRemove_Click"/>
                <Rectangle Width="1" Height="28" Fill="#E5E7EB" Margin="10,0"/>
                <Button x:Name="BtnRun" Content="▶  Run Selected"
                        Style="{StaticResource PrimaryBtn}"
                        Margin="6,0" Click="BtnRun_Click"/>
                <Button x:Name="BtnRunAll" Content="▶▶  Run All"
                        Style="{StaticResource PrimaryBtn}"
                        Margin="6,0" Click="BtnRunAll_Click"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
